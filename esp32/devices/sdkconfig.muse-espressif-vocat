# Espressif ESP-VoCat (EchoEar): round 1.85" 360x360 ST77916 touch LCD,
# ES8311 speaker and ES7210 microphones, BQ27220 fuel gauge.
# v1.2: ESP32-S3-WROOM-1-N16R16VA, 16 MB quad flash and 16 MB octal PSRAM.
# v1.0: ESP32-S3-WROOM-2-N32R16V, 32 MB octal flash and 16 MB octal PSRAM; the
# bootloader finds the octal flash itself (ESPTOOLPY_FLASH_MODE_AUTO_DETECT)
# and this build uses its first 16 MB.
# Native USB Serial/JTAG (303a:1001), BOOT on GPIO0.
# Sources: https://github.com/espressif/esp-bsp/tree/master/bsp/esp_vocat,
# https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s3/echoear/
# and xiaozhi-esp32's main/boards/espressif/esp-vocat.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ESPRESSIF_VOCAT=y
# Unused by Muse builds (the talk button confirms pairing).
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# The console on USB, which leaves UART0's pins to the green LED (GPIO43) and
# the backlight (GPIO44).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM is required for the UI, images, voice session and tunnel. Octal, as on
# the BOX-3.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). The chip always has
# PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
